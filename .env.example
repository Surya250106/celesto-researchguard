# Celesto ResearchGuard Environment Configuration Template
# Copy this file to .env and configure your local or cloud values.
# NEVER commit real credentials or .env to version control!

# Celesto Execution Zone Configuration
# Allowed providers: "cloud" or "local" (default: "cloud")
CELESTO_PROVIDER=cloud
# Celesto API Key obtained from https://celesto.ai (Settings -> Security)
CELESTO_API_KEY=celesto_api_key_placeholder
# Backend for local execution when CELESTO_PROVIDER=local ("auto", "qemu", "firecracker")
CELESTO_BACKEND=auto

# Trusted Control Plane Database Configuration
# PostgreSQL connection string for the Run Ledger
DATABASE_URL=postgresql+psycopg://postgres:postgres@ledger:5432/researchguard

# Control Plane API Configuration
API_PORT=8080
API_HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# LLM Orchestration Configuration (Optional - bounded steps run deterministically)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=llm_api_key_placeholder
LLM_MODEL=gpt-4o-mini

# Testing and Simulation Hooks
# When set to "true" in offline development without cloud access, allows dry-run verification
MOCK_SANDBOX_FOR_OFFLINE_TESTS=false
# Inject failure at Step 7 for testing Step-7 Recovery Policy
INJECT_STEP7_FAILURE=false
